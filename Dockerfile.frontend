# ── WorldWeaver Frontend ──────────────────────────────────────────────────────
# Vite build → nginx static serving + WebSocket reverse proxy to backend
# Dokploy: deploy as a separate service, expose port 80
#
# Env vars at runtime:
#   BACKEND_HOST - backend service hostname (default: worldweaver-backend)

# -- Build stage ---------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ .

RUN npm run build

# -- Runtime stage -------------------------------------------------------------
FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx template — official nginx image runs envsubst on /etc/nginx/templates/
# at startup, outputting to /etc/nginx/conf.d/
# NGINX_ENVSUBST_FILTER restricts which vars get substituted (avoids clobbering $uri etc.)
COPY nginx.conf /etc/nginx/templates/default.conf.template

ENV BACKEND_URL=http://worldweaver-backend:8080
ENV NGINX_ENVSUBST_FILTER=BACKEND_URL

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
