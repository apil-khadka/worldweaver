# ── WorldWeaver Frontend ──────────────────────────────────────────────────────
# Vite build → nginx static serving + WebSocket reverse proxy to backend
# Dokploy: deploy as a separate service, expose port 80
#
# Env vars at runtime:
#   BACKEND_URL - full backend URL (default: http://worldweaver-backend:8080)

# -- Build stage ---------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ .

RUN npm run build

# -- Runtime stage -------------------------------------------------------------
FROM nginx:alpine

# Remove default config
RUN rm -f /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx template
COPY nginx.conf /etc/nginx/nginx.conf.template

ENV BACKEND_URL=http://worldweaver-backend:8080

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

# Substitute only BACKEND_URL, preserving all nginx $ variables
CMD ["/bin/sh", "-c", "envsubst '${BACKEND_URL}' < /etc/nginx/nginx.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
