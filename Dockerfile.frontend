# ── WorldWeaver Frontend ──────────────────────────────────────────────────────
# Vite build → nginx static serving + WebSocket reverse proxy to backend
# Dokploy: deploy as a separate service, expose port 80
#
# Env vars at runtime:
#   BACKEND_URL - full backend origin (default: http://worldweaver-backend:8080)

# -- Build stage ---------------------------------------------------------------
FROM node:20-slim AS builder

WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ .

RUN npm run build

# -- Runtime stage -------------------------------------------------------------
FROM nginx:stable

# The Debian nginx image is intentionally minimal and does not include curl.
# Install it because the container healthcheck exercises the served HTTP path.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx template
COPY nginx.conf /etc/nginx/nginx.conf.template

ENV BACKEND_URL=http://worldweaver-backend:8080
# BACKEND_HOST is retained for existing Dokploy environments. A public host
# is treated as HTTPS; the local Compose service keeps its port 8080 URL.
ENV BACKEND_HOST=

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -fs http://127.0.0.1:80/ || exit 1

# Substitute only BACKEND_URL, preserving nginx's own $ variables.
# Prefer the new full-origin variable, but keep existing BACKEND_HOST
# deployments working without requiring a dashboard change.
CMD ["/bin/sh", "-c", "if [ -n \"$BACKEND_HOST\" ]; then case \"$BACKEND_HOST\" in http://*|https://*) BACKEND_URL=\"$BACKEND_HOST\" ;; worldweaver-backend) BACKEND_URL=\"http://$BACKEND_HOST:8080\" ;; *) BACKEND_URL=\"https://$BACKEND_HOST\" ;; esac; fi; export BACKEND_URL; envsubst '$BACKEND_URL' < /etc/nginx/nginx.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
