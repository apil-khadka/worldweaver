# ── WorldWeaver Backend ───────────────────────────────────────────────────────
# Go server: simulation engine + WebSocket API
# Dokploy: deploy as a separate service, expose port 8080 internally

# -- Build stage ---------------------------------------------------------------
FROM golang:1.27-alpine AS builder

# Allow Go to download the toolchain version specified in go.mod
ENV GOTOOLCHAIN=auto

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags='-s -w' \
    -o /worldweaver \
    ./cmd/server

# -- Runtime stage -------------------------------------------------------------
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 1000 worldweaver

WORKDIR /app

COPY --from=builder /worldweaver /app/worldweaver

# Snapshot persistence volume
RUN mkdir -p /app/data && chown worldweaver:worldweaver /app/data
VOLUME ["/app/data"]

USER worldweaver

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/worldweaver"]
CMD ["-addr", ":8080", "-snapdir", "/app/data"]
